{
  "name": "dsh-plugin-trim",
  "version": "0.1.0",
  "description": "DSH plugin ecosystem diet and compatibility analyzer",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.png"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "compatibility",
    "plugin-management"
  ],
  "license": "MIT",
  "icon": "./icon.png",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.1.0",
    "@deepseek-ai/dsh": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-app-boot": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-host-plugin-inventory": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-plugin-manager": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-plugin-inventory": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.7.0",
    "dsh-shared-meta": "workspace:*",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
  },
  "author": "Starlit-Sky-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Starlit-Sky-code/dsh-experience-optimizer.git",
    "directory": "packages/plugin-trim"
  },
  "homepage": "https://github.com/Starlit-Sky-code/dsh-experience-optimizer/tree/main/packages/plugin-trim#readme",
  "bugs": {
    "url": "https://github.com/Starlit-Sky-code/dsh-experience-optimizer/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
