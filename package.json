{
  "name": "dsh-experience-optimizer",
  "version": "0.5.9",
  "private": true,
  "type": "module",
  "description": "DSH plugin checkup and compatibility analysis suite",
  "license": "AGPL-3.0-only",
  "dsh": {
    "bundle": {
      "patch": "./packages/plugin-trim/cordis.patch.yml"
    }
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "verify": "pnpm build && node scripts/verify-packages.mjs && vitest run",
    "smoke:profile": "node scripts/smoke-profile.mjs",
    "report": "node scripts/acceptance-report.mjs",
    "promo": "node scripts/make-promo.mjs",
    "market:index": "node scripts/build-market-index.mjs",
    "market:check": "node scripts/build-market-index.mjs --check"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.2-rc.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^31.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "author": "Starlit-Sky-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Starlit-Sky-code/dsh-experience-optimizer.git"
  },
  "homepage": "https://github.com/Starlit-Sky-code/dsh-experience-optimizer#readme",
  "bugs": {
    "url": "https://github.com/Starlit-Sky-code/dsh-experience-optimizer/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-manager",
    "compatibility",
    "context",
    "plugin-suite"
  ],
  "dependencies": {
    "dsh-plugin-trim": "^0.5.9"
  },
  "files": [
    "packages/plugin-trim/cordis.patch.yml",
    "icon.png",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "icon": "./icon.png"
}
